# ==========================================================
# متغيرات البيئة لمنصة رياضيات ولاية الوادي — انسخ إلى .env.local
# ==========================================================

# إلزامي: مشروع Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# اختياري (خادم فقط): إنشاء حسابات المفتشين وحذف الحسابات من لوحة المشرف العام
SUPABASE_SERVICE_ROLE_KEY=

# اختياري: ترحيل بيانات الموقع القديم (lessons-db.json) إلى حساب هذا الأستاذ عند أول دخول
LEGACY_OWNER_EMAIL=
BLOB_PRIVATE_READ_WRITE_TOKEN=
BLOB_READ_WRITE_TOKEN=
